desc:PoulpyLoop_v0702 // uniformisation adresses memoire
options:maxmem=32000000
options:gmem=PoulpyLoopy

in_pin:Left In
in_pin:Right In
out_pin:Left Out
out_pin:Right Out

slider1:40<0,256,1>Fade (échantillons)
slider2:0.0<-24,24,1>Pitch Control
slider3:0<0,1,1{OFF,ON}>Monitoring à l'arrêt
slider4:0<0,63,1>Instance ID (auto - ne pas toucher)


@init

ext_noinit = 1;
NUM_NOTES = 128;
UNIT_SIZE = 4096 * 64;
max_units = 32000000 / UNIT_SIZE;



current_display= 200;
note_start    = 300;
note_length   = note_start    + NUM_NOTES;
units_count   = note_length   + NUM_NOTES;
is_playing    = units_count   + NUM_NOTES;
is_recording  = is_playing    + NUM_NOTES;
read_pos      = is_recording  + NUM_NOTES;
rec_mode      = read_pos      + NUM_NOTES;
next_free_unit = rec_mode     + NUM_NOTES;
// Réservation mémoire pour la liste des notes actives (128 max)
active_notes = next_free_unit + NUM_NOTES; // 128 cases pour les notes actives
// Mémoire audio principale, commence juste après active_notes
// (aucun risque de collision avec les autres structures)
the_memory = active_notes + NUM_NOTES;
num_active_notes = 0;

i = 0;
loop(NUM_NOTES,
  note_start[i] = 0;
  note_length[i] = 0;
  units_count[i] = 0;
  is_playing[i] = 0;
  is_recording[i] = 0;
  read_pos[i] = 0;  
  rec_mode[i] = 0;
  i += 1;
);
next_free_unit[0] = 0;

i = 0;
loop(NUM_NOTES,
  loop_type[i] = -1;
  i += 1;
);

volumeFactor = 1.0;
panFactor    = 0.5;
last_panFactor = -1; // force le calcul des gains de pan au premier bloc (I2)
monitoring = 1; // Par défaut, le monitoring est activé (ON)

// Variable pour stocker le dernier pitch
last_pitch = 0.5; // Valeur par défaut (milieu)
last_pitch_sent = -1; // dernier CC9 envoye a Guitar Rig (-1 = force le 1er envoi) (C2)

// Variable temporaire pour stocker le mode mono/stéréo courant
current_mode = 0; // Par défaut mono



// Variables pour la position de début du bloc (mode PLAYBACK via CC108-110) 
item_start_sixteenths = 0;  // Position de début en 1/16 beats  
item_start_beats = 0.0;     // Position de début en beats (calculée)
cc108_val = 0; cc109_val = 0; cc110_val = 0;  // Valeurs des 3 CC

play_state = 0;

// Variable pour stocker le dernier numéro de reset
last_reset_number = 0;



// Indices gmem pour les modes
// <GMEM_CONTRACT_BEGIN>
// Source unique du plan memoire gmem : lu automatiquement par les scripts Lua
// (PoulpyLoopyCore.lua -> LoadGmemContract). Convention stricte : une declaration
// par ligne sous la forme "GMEM_NOM = <entier>;" (valeurs entieres uniquement).
GMEM_RECORD_MONITOR_MODE = 0;  // gmem[0] pour le mode d'enregistrement des loops MONITOR
GMEM_PLAYBACK_MODE = 1;        // gmem[1] pour le mode LIVE/PLAYBACK
GMEM_STATS_BASE = 2;           // gmem[2] à gmem[2+64*3-1] pour les statistiques (64 instances max)
GMEM_NEXT_INSTANCE_ID = 194;   // gmem[194] pour le prochain ID d'instance disponible
GMEM_MONITORING_STOP_BASE = 195;  // gmem[195] à gmem[195+64-1] pour le monitoring à l'arrêt (64 instances max)
GMEM_NOTE_START_POS_BASE = 259;  // gmem[259] à gmem[259+64*128-1] pour les positions de début des notes (64 instances * 128 notes)
GMEM_LOOP_LENGTH_BASE = 8451;    // gmem[8451] à gmem[8451+64*128-1] pour les longueurs des boucles en secondes (64 instances * 128 notes)
GMEM_RESET_PLUGINS_BASE = 16200; // gmem[16200] à gmem[16200+64-1] pour les signaux de reset des plugins (64 instances max)
// <GMEM_CONTRACT_END>




// Identifiant d'instance (C3/C4) : fourni par les scripts Lua via slider4
// (= index de la piste parmi les pistes PoulpyLoop). Source unique et stable,
// partagee avec l'UI, qui remplace l'ancien compteur tournant gmem[NEXT_INSTANCE_ID]
// (sujet aux collisions au-dela de 64 (re)initialisations et au desalignement UI).
instance_id = max(0, floor(slider4));  // 0..63, attribue par le Lua



// Fonction pour récupérer le mode d'enregistrement des loops MONITOR
function get_record_monitor_loops_mode()
(
  gmem[GMEM_RECORD_MONITOR_MODE];
);

// Fonction pour récupérer le mode LIVE/PLAYBACK
function get_playback_mode()
(
  gmem[GMEM_PLAYBACK_MODE];
);

function cc7ToGain(ccVal)
(
  dB = (ccVal - 64) * (20.0/64.0);
  10^(dB/20.0);
);

function cc10ToPan(ccVal)
(
  ccVal / 127.0;
);

function getNoteIndex(note)
(
  (note >= 0 && note < 128) ? note : -1;
);

function startRecording(note, note_mode)
(
  // En mode PLAYBACK, on n'enregistre pas
  (get_playback_mode() == 1) ? (
    sprintf(current_display, "PLAYBACK mode : recording disabled");
    0; // Ne rien faire
  ) : (

    
    note_length[note] = 0;
    units_count[note] = 1;
    is_recording[note] = 1;
    is_playing[note] = 0;
    read_pos[note] = 0;
    rec_mode[note] = note_mode;
    nu = next_free_unit[0];
    (nu >= max_units) ? (
      is_recording[note] = 0;
      note_start[note] = 0;
      strcpy(current_display, "Memo saturée: impossible rec");

    ) : (
      note_start[note] = nu * UNIT_SIZE;
      
      // Calculer combien d'unités ce bloc va occuper
      units_needed = note_mode ? 2 : 1;  // Stéréo = 2 unités, Mono = 1 unité
      next_free_unit[0] = nu + units_needed;
      

    );
  );
);

function expandRecording(note)
(
  // En mode PLAYBACK, on n'étend pas l'enregistrement
  (get_playback_mode() == 1) ? (
    0; // Ne rien faire
  ) : (
    nu = next_free_unit[0];
    curUnits = units_count[note];
    (nu < max_units) ? (
      units_count[note] = curUnits + 1;
      // Calculer combien d'unités supplémentaires sont nécessaires
      units_needed = rec_mode[note] ? 2 : 1;
      next_free_unit[0] = nu + units_needed;
    ) : (
      is_recording[note] = 0;
      strcpy(current_display, "Memo full en cours d'enregistrement");
    );
  );
);

@slider
fade_samples = slider1;
// Suivre l'id attribue par le Lua (slider4) avant tout acces gmem indexe (C3/C4)
instance_id = max(0, floor(slider4));
// Mettre à jour gmem avec l'état du monitoring à l'arrêt
gmem[GMEM_MONITORING_STOP_BASE + instance_id] = slider3;

@block
// Vérifier si un reset a été demandé pour cette instance
reset_signal = gmem[GMEM_RESET_PLUGINS_BASE + instance_id];
(reset_signal > 0) ? (
  // Effectuer le reset complet

  
  // Réinitialiser toutes les structures de données
  i = 0;
  loop(NUM_NOTES,
    note_start[i] = 0;
    note_length[i] = 0;
    units_count[i] = 0;
    is_playing[i] = 0;
    is_recording[i] = 0;
    read_pos[i] = 0;
    rec_mode[i] = 0;
    loop_type[i] = -1;
    i += 1;
  );
  
  // Réinitialiser le compteur d'allocation mémoire
  next_free_unit[0] = 0;
  
  // Réinitialiser la liste des notes actives
  num_active_notes = 0;
  
  // Réinitialiser les variables temporaires
  current_mode = 0; // Réinitialiser le mode à mono
  

  
  // Stocker le numéro de reset et acquitter le signal
  last_reset_number = reset_signal;
  gmem[GMEM_RESET_PLUGINS_BASE + instance_id] = 0;
);

// Synchroniser le slider avec gmem
slider3 = gmem[GMEM_MONITORING_STOP_BASE + instance_id];

// Mode LIVE/PLAYBACK : lu une seule fois par bloc, reutilise dans @sample (C1)
playback_mode = get_playback_mode();

// Obtenir la position de lecture actuelle
play_position = play_position_samples / srate;

// Détection simple de l'état de lecture
prev_play_state = play_state;
play_state = (play_state > 0) ? 1 : 0;

// Variable pour suivre si des notes ont été traitées dans ce bloc
midi_notes_processed = 0;

while (
  midirecv(offset, msg1, msg2, msg3) ? (
    status = msg1 & $xF0;
    note   = msg2;
    vel    = msg3;
    idx    = getNoteIndex(note);
    
    // Augmenter le compteur de notes MIDI traitées
    (status == $x90 && vel > 0) ? (
      midi_notes_processed += 1;
    );

    (status == $xB0) ? (
      (idx >= 0) ? (
        (msg2 == 7) ? (
            volumeFactor = cc7ToGain(msg3);
        ) : (msg2 == 9) ? (
            slider2 = msg3 - 64;
        ) : (msg2 == 10) ? (
            panFactor = cc10ToPan(msg3);
        ) : (msg2 == 11) ? (
            monitoring = msg3 > 0 ? 1 : 0;
        ) : (msg2 == 29) ? (
            // CC29: Définit le mode mono/stéréo pour la prochaine note
            current_mode = msg3;
        ) : (msg2 == 108) ? (
            // CC108: Bits 0-6 de item_start_sixteenths
            cc108_val = msg3;

        ) : (msg2 == 109) ? (
            // CC109: Bits 7-13 de item_start_sixteenths  
            cc109_val = msg3;

        ) : (msg2 == 110) ? (
            // CC110: Bits 14-20 de item_start_sixteenths
            cc110_val = msg3;
            // Reconstruire item_start_sixteenths quand on a reçu le dernier CC
            item_start_sixteenths = cc108_val + (cc109_val << 7) + (cc110_val << 14);
            item_start_beats = item_start_sixteenths / 16.0;
            sprintf(current_display, "Item start: %.3f beats", item_start_beats);

        );
      );
    );

    (status == $x90 && vel > 0) ? (  // Note ON
      (idx >= 0) ? (
        // Ajout à la liste des notes actives si pas déjà présente
        found = 0;
        j = 0;
        loop(num_active_notes,
          (active_notes[j] == idx) ? (found = 1;);
          j += 1;
        );
        (found == 0) ? (
          active_notes[num_active_notes] = idx;
          num_active_notes += 1;
        );

        // Stocker la position de début de la note dans gmem
        note_pos_index = GMEM_NOTE_START_POS_BASE + instance_id * 128 + idx;
        gmem[note_pos_index] = play_position;
        
        // Stocker la longueur de la boucle en secondes si elle existe
        loop_len_index = GMEM_LOOP_LENGTH_BASE + instance_id * 128 + idx;
        (note_length[idx] > 0) ? (
          gmem[loop_len_index] = note_length[idx] / srate;
        ) : (
          gmem[loop_len_index] = -1;
        );
        
        // Vérifier si on est en mode PLAYBACK
        playback_mode = get_playback_mode();
        
        (vel == 1) ? ( // RECORD
          (playback_mode == 1) ? (
            // En mode PLAYBACK, on lit la loop RECORD si elle existe
            (note_length[idx] > 0) ? (
              is_playing[idx] = 1;
              
              // Calculer l'offset basé sur beat_position et item_start_beats

              (note_length[idx] > 0) ? (
                offset_beats = beat_position - item_start_beats;

                (offset_beats >= 0) ? (
                  loop_length_sec = note_length[idx] / srate;
                  loop_length_beats = loop_length_sec * (tempo / 60.0);  // Conversion en beats

                  actual_offset_beats = offset_beats % loop_length_beats;  // Modulo pour bouclage
                  // Correction: éviter le cas où offset_beats est exactement égal à loop_length_beats
                  (actual_offset_beats >= loop_length_beats) ? actual_offset_beats = loop_length_beats - 0.001;
                  actual_offset_sec = actual_offset_beats * (60.0 / tempo);
                  read_pos[idx] = actual_offset_sec * srate;

                ) : (
                  read_pos[idx] = 0;

                );
              ) : (
                read_pos[idx] = 0;
              );
              
              is_recording[idx] = 0;
              loop_type[idx] = 0; // Garder le type RECORD
              sprintf(current_display, "RECORD: beat=%.2f offset=%.2fb", beat_position, offset_beats);
            ) : (
              sprintf(current_display, "Playback: no content for RECORD note=%d", note);
            );
          ) : (
            // En mode LIVE, comportement normal

            startRecording(idx, current_mode);
            loop_type[idx] = 0;
          );
        )
        : (vel == 2) ? ( // PLAY
          (playback_mode == 1) ? (
            // En mode PLAYBACK, on lit la loop PLAY si elle existe
            (note_length[idx] > 0) ? (
              is_playing[idx] = 1;
              
              // Calculer l'offset basé sur beat_position et item_start_beats
              (note_length[idx] > 0) ? (
                offset_beats = beat_position - item_start_beats;
                (offset_beats >= 0) ? (
                  loop_length_sec = note_length[idx] / srate;
                  loop_length_beats = loop_length_sec * (tempo / 60.0);  // Conversion en beats
                  actual_offset_beats = offset_beats % loop_length_beats;  // Modulo pour bouclage
                  // Correction: éviter le cas où offset_beats est exactement égal à loop_length_beats
                  (actual_offset_beats >= loop_length_beats) ? actual_offset_beats = loop_length_beats - 0.001;
                  actual_offset_sec = actual_offset_beats * (60.0 / tempo);
                  read_pos[idx] = actual_offset_sec * srate;

                ) : (
                  read_pos[idx] = 0;

                );
              ) : (
                read_pos[idx] = 0;
              );
              
              is_recording[idx] = 0;
              loop_type[idx] = 1;
              sprintf(current_display, "PLAY: beat=%.2f offset=%.2fb", beat_position, offset_beats);
            ) : (
              sprintf(current_display, "Playback: no content for PLAY note=%d", note);
            );
          ) : (
            // En mode LIVE, comportement normal
            (note_length[idx] > 0) ? (

              
              is_playing[idx] = 1;
              read_pos[idx] = 0;  // Commencer au début en mode LIVE
              is_recording[idx] = 0;
              loop_type[idx] = 1;
            ) : sprintf(current_display, "No sample for %d", note);
          )
        )
        : (vel == 3) ? ( // OVERDUB
          (playback_mode == 1) ? (
            // En mode PLAYBACK, on lit la loop OVERDUB si elle existe
            (note_length[idx] > 0) ? (
              is_playing[idx] = 1;
              
              // Calculer l'offset basé sur beat_position et item_start_beats
              (note_length[idx] > 0) ? (
                offset_beats = beat_position - item_start_beats;
                (offset_beats >= 0) ? (
                  loop_length_sec = note_length[idx] / srate;
                  loop_length_beats = loop_length_sec * (tempo / 60.0);  // Conversion en beats
                  actual_offset_beats = offset_beats % loop_length_beats;  // Modulo pour bouclage
                  // Correction: éviter le cas où offset_beats est exactement égal à loop_length_beats
                  (actual_offset_beats >= loop_length_beats) ? actual_offset_beats = loop_length_beats - 0.001;
                  actual_offset_sec = actual_offset_beats * (60.0 / tempo);
                  read_pos[idx] = actual_offset_sec * srate;

                ) : (
                  read_pos[idx] = 0;

                );
              ) : (
                read_pos[idx] = 0;
              );
              
              is_recording[idx] = playback_mode == 0;
              loop_type[idx] = 2;
              sprintf(current_display, "OVERDUB: beat=%.2f offset=%.2fb", beat_position, offset_beats);
            ) : (
              sprintf(current_display, "Playback: no content for OVERDUB note=%d", note);
            );
          ) : (
            // En mode LIVE, comportement normal
            //Si la boucle n'existait pas, on démarre un enregistrement normal.
            (note_length[idx] == 0) ? (
              startRecording(idx, current_mode);
            ) : (
              is_recording[idx] = 1;  // Activer l'enregistrement
              read_pos[idx] = 0;      // Réinitialisation de la position de lecture
            );
            loop_type[idx] = 2;
            is_playing[idx] = 1;      // Activer la lecture en mode OVERDUB
            sprintf(current_display, "Overdub note=%d vel=%d mode=%s", note, vel, current_mode ? "Stereo" : "Mono");
          );
        )
        : (vel == 4) ? ( // MONITOR
          (playback_mode == 1) ? (
            // En mode PLAYBACK, on lit la loop MONITOR si elle existe
            (note_length[idx] > 0) ? (
              is_playing[idx] = 1;
              
              // Calculer l'offset basé sur beat_position et item_start_beats

              (note_length[idx] > 0) ? (
                offset_beats = beat_position - item_start_beats;

                (offset_beats >= 0) ? (
                  loop_length_sec = note_length[idx] / srate;
                  loop_length_beats = loop_length_sec * (tempo / 60.0);  // Conversion en beats

                  actual_offset_beats = offset_beats % loop_length_beats;  // Modulo pour bouclage
                  // Correction: éviter le cas où offset_beats est exactement égal à loop_length_beats
                  (actual_offset_beats >= loop_length_beats) ? actual_offset_beats = loop_length_beats - 0.001;
                  actual_offset_sec = actual_offset_beats * (60.0 / tempo);
                  read_pos[idx] = actual_offset_sec * srate;

                ) : (
                  read_pos[idx] = 0;

                );
              ) : (
                read_pos[idx] = 0;
              );
              
              is_recording[idx] = 0; // Pas d'enregistrement en mode PLAYBACK
              loop_type[idx] = 3; // Garder le type MONITOR
              sprintf(current_display, "MONITOR: beat=%.2f offset=%.2fb", beat_position, offset_beats);
            );
          ) : (
            // En mode LIVE, traitement IDENTIQUE aux blocs RECORD
            record_monitor_mode = get_record_monitor_loops_mode();
            (record_monitor_mode == 1) ? (
              // Mode ON : traitement IDENTIQUE à un bloc RECORD
              startRecording(idx, current_mode);
              loop_type[idx] = 3;
              sprintf(current_display, "Rec MONITOR note=%d vel=%d mode=%s", note, vel, current_mode ? "Stereo" : "Mono");
            ) : (
              // Mode OFF : juste monitoring, pas d'enregistrement
              is_playing[idx] = 1;
              loop_type[idx] = 3;
              sprintf(current_display, "Monitor only note=%d", note);
            );
          );
        )
        : sprintf(current_display, "Vel. not supported: %d", vel)
      );
    );

    (status == $x80 || (status == $x90 && vel == 0)) ? ( // NOTE OFF
      (idx >= 0) ? (
        // Réinitialiser la position de début de la note
        note_pos_index = GMEM_NOTE_START_POS_BASE + instance_id * 128 + idx;
        gmem[note_pos_index] = -1;
        

        
        is_playing[idx] = 0;
        is_recording[idx] = 0;
        loop_type[idx] = -1;
        // Note: Le pitch est maintenant géré uniquement par les scripts Lua
        // Pas de reset automatique pour préserver la cohérence entre blocs
        strcpy(current_display, "Note off");

        // Retrait de la liste des notes actives
        j = 0;
        loop(num_active_notes,
          (active_notes[j] == idx) ? (
            k = j;
            loop(num_active_notes - j - 1,
              active_notes[k] = active_notes[k+1];
              k += 1;
            );
            num_active_notes -= 1;
            break;
          );
          j += 1;
        );
      );
    );
    offset += 1;
  );
);

// Cache des gains de pan : recalcul uniquement quand panFactor change (I2).
// panFactor n'evolue qu'a la reception d'un CC10, traite ci-dessus dans ce meme bloc.
(panFactor != last_panFactor) ? (
  gainL = cos($pi * 0.5 * panFactor) * sqrt(2);
  gainR = sin($pi * 0.5 * panFactor) * sqrt(2);
  last_panFactor = panFactor;
);

// Envoi du pitch (CC09) vers Guitar Rig (C2).
// Avant : renvoye a chaque bloc des qu'une note est active (flux MIDI permanent).
// Desormais : seulement quand la valeur change OU qu'une note vient de demarrer dans
// ce bloc (resynchro au demarrage de note). Place apres le traitement MIDI pour
// refleter slider2 et les notes du bloc courant.
pitch_to_send = slider2 + 64;
(num_active_notes > 0 && (pitch_to_send != last_pitch_sent || midi_notes_processed > 0)) ? (
  midisend(0, $xB0, 9, pitch_to_send);
  last_pitch_sent = pitch_to_send;
);

@sample
// Bypass logiciel si aucune note active et monitoring désactivé
(num_active_notes == 0 ) ? (
  (!play_state && slider3)?(
  spl0 = spl0;
  spl1 = spl0;
  ):(
  spl0 = 0;
  spl1 = 0;
  )
 ):
 (

 


inL = spl0;
inR = spl1;

recL = 0;
recR = 0;
playL = 0;
playR = 0;
monL = 0;
monR = 0;

// Gains de pan calcules une fois par bloc dans @block (cache I2)

// Variable pour détecter si au moins une boucle est active
any_loop_active = 0;
// Mode de monitoring mono/stereo : capture dans la boucle principale (I3),
// equivaut a l'ancienne 2e boucle qui prenait le rec_mode de la derniere note active.
monitor_mode = 0;

// Mode LIVE/PLAYBACK : recupere une fois par bloc (voir @block, C1)

i = 0;
loop(num_active_notes,
  n = active_notes[i];
  (loop_type[n] != -1) ? (  // Boucle active
    any_loop_active = 1;
    monitor_mode = rec_mode[n]; // capture pour le monitoring (I3)
    curLen = note_length[n];
    monitor_length = 0;
    unitCount = units_count[n];
    capacity = unitCount * UNIT_SIZE;
    
    // Incrémenter read_pos pour la lecture, l'enregistrement et les blocs MONITOR
    ((is_playing[n] || is_recording[n]) && (curLen > 0 || is_recording[n])) ? (
      read_pos[n] += 1;
      // Gestion du bouclage identique pour tous les types de blocs
      (read_pos[n] >= curLen && !is_recording[n]) ? read_pos[n] = 0;
      pos = read_pos[n];
      
      // Calculer la position de lecture effective avec l'offset
      effective_pos = pos;
    ) : (
      // Si pas en lecture/enregistrement, maintenir la position actuelle
      pos = read_pos[n];
      effective_pos = pos;
    );
    
    // Lire le contenu actuel si en lecture ou en mode particulier
    ((is_playing[n] && curLen > 0) || playback_mode == 1) ? (
      // Calcul des enveloppes de fade
      fade_gain = 1.0;
      (fade_samples > 0) ? (
        (effective_pos < fade_samples) ? (
          fade_gain = effective_pos / fade_samples;
        ) : (effective_pos >= curLen - fade_samples) ? (
          fade_gain = (curLen - effective_pos) / fade_samples;
        );
      );
      
      // Vérifier que effective_pos est dans les bornes du sample
      (effective_pos < curLen) ? (
        (rec_mode[n] == 0) ? ( // MONO
          sampleMono = the_memory[note_start[n] + effective_pos];
          playL += sampleMono * volumeFactor * gainL * fade_gain;
          playR += sampleMono * volumeFactor * gainR * fade_gain;
        ) : ( // STEREO
          baseOfs = note_start[n] + 2*effective_pos;
          

          
          sampleL = the_memory[baseOfs];
          sampleR = the_memory[baseOfs+1];
          playL += sampleL * volumeFactor * gainL * fade_gain;
          playR += sampleR * volumeFactor * gainR * fade_gain;
        );
      );
    );


    
    // Gérer l'enregistrement après la lecture (uniquement en mode LIVE)
    (playback_mode == 0 && (loop_type[n] == 0 || loop_type[n] == 2 || (loop_type[n] == 3 && is_recording[n]))) ? (
      // Appliquer volume/pan selon le mode de la note courante
      (rec_mode[n] == 0) ? ( // Mono - lire uniquement l'entrée gauche
        recL = inL * gainL;
        recR = inL * gainR;  // Même signal en mono
      ) : ( // Stereo - lire les deux entrées
        recL = inL * gainL;
        recR = inR * gainR;
      );

      // Position d'écriture - pour OVERDUB, utiliser le même loopPos que pour la lecture
      writePos = (loop_type[n] == 2) ? (pos % curLen) : curLen;
      
      (loop_type[n] == 0 || loop_type[n] == 3) ? (  // RECORD ou MONITOR avec enregistrement
        (rec_mode[n] == 0) ? ( // Mono
          the_memory[note_start[n] + writePos] = recL;
        ) : ( // Stereo
          the_memory[note_start[n] + 2*writePos] = recL;
          the_memory[note_start[n] + 2*writePos+1] = recR;
        );

        // Correction : forcer note_length[n]=1 dès le premier sample
        note_length[n] = (curLen == 0) ? 1 : curLen + 1;
        (curLen + 1 >= capacity) ? (
          expandRecording(n);
        );
      ) : (  // OVERDUB - ici on ADDITIONNE au lieu de remplacer
        (curLen > 0) ? (  // Seulement si on a déjà du contenu
          (rec_mode[n] == 0) ? ( // Mono
            the_memory[note_start[n] + writePos] += recL;
          ) : ( // Stereo
            the_memory[note_start[n] + 2*writePos] += recL;
            the_memory[note_start[n] + 2*writePos+1] += recR;
          );
        ) : (
          // Si longueur=0 en OVERDUB, traiter comme RECORD
          (rec_mode[n] == 0) ? ( // Mono
            the_memory[note_start[n] + writePos] = recL;
          ) : ( // Stereo
            the_memory[note_start[n] + 2*writePos] = recL;
            the_memory[note_start[n] + 2*writePos+1] = recR;
          );
          // Correction : forcer note_length[n]=1 dès le premier sample
          note_length[n] = 1;
          (curLen + 1 >= capacity) ? (expandRecording(n));
        );
      );
    );
  );
  i += 1;
);

// Monitoring avec pan sinusoïdal (uniquement si une boucle est active, qu'on n'est pas en mode PLAYBACK
// ET que la lecture est active OU que le monitoring à l'arrêt n'est pas activé)
(monitoring && any_loop_active && playback_mode == 0 && (play_state || !slider3)) ? (
  // monitor_mode est deja calcule dans la boucle principale (I3)
  (monitor_mode == 0) ? ( // Mono - lire uniquement l'entrée gauche
    monL = inL * volumeFactor * gainL;
    monR = inL * volumeFactor * gainR;  // Même signal en mono
  ) : ( // Stereo - lire les deux entrées
    monL = inL * volumeFactor * gainL;
    monR = inR * volumeFactor * gainR;
  );
);

// Complètement réorganiser la logique de sortie pour éviter les additifs
(!play_state && slider3) ? (
  // Monitoring à l'arrêt est prioritaire quand lecture arrêtée - signal DIRECT sans traitement
  spl0 = inL;
  spl1 = inR;
) : (
  // Lecture normale, uniquement le contenu joué + monitoring normal
  spl0 = playL;
  spl1 = playR;
  
  // Ajouter le monitoring UNIQUEMENT si on n'est pas en mode monitoring à l'arrêt
  (!(!play_state && slider3)) ? (
    spl0 += monL;
    spl1 += monR;
  );
);

